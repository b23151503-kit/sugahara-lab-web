---
import '../styles/global.css';
import { SITE, NAV, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  current?: string;
}
const { title, description = SITE.description, overlayHeader = false, current = '' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.nameJa}` : `${SITE.nameJa} | ${SITE.nameEn}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// プレビュー(GitHub Pages)用のビルドのときだけ表示する目印
const previewLabel = process.env.PREVIEW_LABEL;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {previewLabel && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(url('/images/hero/group.jpg'), Astro.site)} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">本文へスキップ</a>
  <header class:list={['site-header', { overlay: overlayHeader }]}>
    <div class="wrap">
      <a class="brand" href={url('/')}>
        <b>{SITE.name}</b>
        <small>{SITE.university} {SITE.nameJa}</small>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く">
        <span class="bars" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="メインメニュー">
        {NAV.map((n) => (
          <a href={url(n.href)} aria-current={current === n.href ? 'page' : undefined}>{n.label}<span class="ja">{n.ja}</span></a>
        ))}
        <a class="contact" href={url('/contact/')} aria-current={current === '/contact/' ? 'page' : undefined}>Contact<span class="ja">お問い合わせ</span></a>
      </nav>
    </div>
  </header>
  <script is:inline>
    (() => {
      const btn = document.querySelector('.menu-btn');
      const header = document.querySelector('.site-header');
      if (!btn || !header) return;
      const set = (open) => {
        header.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      };
      btn.addEventListener('click', () => set(!header.classList.contains('open')));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    })();
  </script>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div>
        <div class="name">{SITE.name}</div>
        <div>{SITE.affiliation}</div>
        <div>{SITE.address}</div>
      </div>
      <nav aria-label="フッターメニュー">
        {NAV.map((n) => <a href={url(n.href)}>{n.ja}</a>)}
        <a href={url('/contact/')}>お問い合わせ</a>
      </nav>
      <div class="copy">© {new Date().getFullYear()} {SITE.name} Kyoto Institute of Technology</div>
    </div>
  </footer>
  {previewLabel && (
    <div class="preview-badge" role="status">プレビュー表示中(ブランチ: {previewLabel})— 本番サイトではありません</div>
  )}
</body>
</html>
