---
// メンバー1人ぶんのカード。
// 業績・経歴・researchmap のどれかがある人だけ、押すと詳細(ポップアップ)が開く。
// 何もない人は押せないカードとして表示する。
import PubItem from './PubItem.astro';
import { url } from '../lib/site';
import { alumniLabel, nameKeys } from '../lib/people';

interface Props { m: any; pubs: any[]; sub?: string; big?: boolean }
const { m, pubs, sub, big = false } = Astro.props;
const d = m.data;
const isAlumni = d.status === '卒業・修了';
const roleText = isAlumni ? alumniLabel(d.role) : d.role;
const hasDetail = pubs.length > 0 || !!d.theme || !!d.researchmap || !!d.website || !!d.societies;
// 経歴(年表)。文字列で書かれていたら1行ずつ「年月 内容」に分ける
const career: { date: string; text: string }[] = Array.isArray(d.career)
  ? d.career
  : (d.career ?? '').split('\n').filter(Boolean).map((l: string) => {
      const m = l.match(/^([\d年月〜~\-.\s]+?)\s+(.*)$/);
      return m ? { date: m[1], text: m[2] } : { date: '', text: l };
    });

const typeGroups = [
  { label: '論文・解説・書籍', types: ['論文', '総説・解説', '書籍', '特許'] },
  { label: '学会発表', types: ['招待講演', '国際学会', '国内学会'] },
  { label: '受賞', types: ['受賞'] },
  { label: '助成金', types: ['助成金'] },
];
const split = (items: any[]) =>
  typeGroups
    .map((g) => ({ ...g, items: items.filter((p) => g.types.includes(p.data.type)) }))
    .filter((g) => g.items.length > 0);
const groups = split(pubs);
const marks = nameKeys(m);
// 各項目は新しい順に最初の SHOW 件だけ見せ、残りは「さらに表示」で開く
const SHOW = 5;
const SHOW = 5; // 種類ごとに最初に見せる件数(新しい順)
const dialogId = `member-${m.id}`;
---
<li class:list={['member-card', { big, 'no-detail': !hasDetail }]}>
  {hasDetail ? (
    <button type="button" class="member-open" data-dialog={dialogId} aria-haspopup="dialog">
      {big && <span class="role">{d.role}{d.note && ` · ${d.note}`}</span>}
      <span class="n">{d.name}</span>
      <span class="e">{d.name_en}</span>
      {sub && <span class="note">{sub}</span>}
      {!big && !isAlumni && d.note && <span class="badge">{d.note}</span>}
      {d.theme && <span class="theme">{d.theme}</span>}
      <span class="count">詳細 <span aria-hidden="true">＋</span></span>
    </button>
  ) : (
    <div class="member-open is-static">
      {big && <span class="role">{d.role}{d.note && ` · ${d.note}`}</span>}
      <span class="n">{d.name}</span>
      <span class="e">{d.name_en}</span>
      {sub && <span class="note">{sub}</span>}
      {!big && !isAlumni && d.note && <span class="badge">{d.note}</span>}
      {d.theme && <span class="theme">{d.theme}</span>}
    </div>
  )}
  {(career.length > 0 || d.website) && (
    <div class="card-extra">
      {d.website && <a class="card-link" href={d.website} target="_blank" rel="noopener">Website <span aria-hidden="true">↗</span></a>}
      {career.length > 0 && (
        <details class="career">
          <summary>経歴 <span class="plus" aria-hidden="true">＋</span></summary>
          <ol class="timeline">
            {career.map((c) => (
              <li>
                {c.date && <span class="t-date">{c.date}</span>}
                <span class="t-text">{c.text}</span>
              </li>
            ))}
          </ol>
        </details>
      )}
    </div>
  )}
  {hasDetail && (
    <dialog id={dialogId} class="member-dialog" aria-labelledby={`${dialogId}-title`}>
      <div class="md-head">
        <div>
          <div class="md-role">{roleText}{d.graduated && isAlumni && ` · ${d.graduated}年`}{d.note && ` · ${d.note}`}</div>
          <h2 id={`${dialogId}-title`}>{d.name}</h2>
          <div class="md-en">{d.name_en}</div>
        </div>
        <button type="button" class="md-close" aria-label="閉じる">×</button>
      </div>
      <div class="md-body">
        {(d.theme || d.researchmap || d.website || d.societies) && (
          <dl class="info">
            {d.theme && <><dt>研究テーマ</dt><dd>{d.theme}</dd></>}
            {d.societies && <><dt>所属学会</dt><dd>{d.societies}</dd></>}
            {d.website && <><dt>Website</dt><dd><a class="ext-link" href={d.website} target="_blank" rel="noopener">{d.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd></>}
            {d.researchmap && <><dt>researchmap</dt><dd><a class="ext-link" href={d.researchmap} target="_blank" rel="noopener">{d.researchmap.replace(/^https?:\/\//, '')}</a></dd></>}
          </dl>
        )}
        {groups.map((g) => (
          <section class="md-sec">
            <h3>{g.label}</h3>
            <ul class="pub-list">
              {g.items.map((p, i) => (
                <li class:list={{ 'is-more': i >= SHOW }} hidden={i >= SHOW}>
                  <PubItem pub={p} showType={g.types.length > 1} highlight={marks} />
                </li>
              ))}
            </ul>
            {g.items.length > SHOW && (
              <button type="button" class="show-more" aria-expanded="false" data-more={`それ以前の${g.label}を表示(${g.items.length - SHOW}件)`} data-less="最新5件だけ表示">
                それ以前の{g.label}を表示({g.items.length - SHOW}件)
              </button>
            )}
          </section>
        ))}
        {pubs.length > 0 && (
          <p><a class="more" href={url(`/publications/?member=${m.id}`)}>業績ページでこの人の実績を検索 →</a></p>
        )}
      </div>
    </dialog>
  )}
</li>
