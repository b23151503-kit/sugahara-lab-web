---
import { norm } from '../lib/people';
interface Props { pub: any; showType?: boolean; highlight?: string[] }
// highlight: 太字にしたい著者名の表記(nameKeys の値)
const { pub, showType = true, highlight = [] } = Astro.props;
const d = pub.data;
const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
const when = d.date ?? String(d.year);
const marks = new Set(highlight);
---
<div class="pub-title">
  {showType && <span class="pub-type">{d.type}</span>}
  {link ? <a href={link} rel="noopener">{d.title}</a> : d.title}
  {d.note && <span class="pub-note">{d.note}</span>}
</div>
<div class="pub-meta">
  {d.authors.map((a: string, i: number) => (
    <>{i > 0 && ', '}{marks.has(norm(a)) ? <b>{a}</b> : a}</>
  ))} — <span class="venue">{d.venue}</span>{d.volume_pages && <>, {d.volume_pages}</>} ({when.replace(/-/g, '.')})
</div>
