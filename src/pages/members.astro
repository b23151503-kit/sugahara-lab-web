---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MemberCard from '../components/MemberCard.astro';
import { url } from '../lib/site';
import { pubsByMember, sortPubs, alumniLabel, themeReview } from '../lib/people';

const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const allMembers = await getCollection('members');
const allPubs = await getCollection('publications');
const pubMap = pubsByMember(sortPubs(allPubs), allMembers);

// 研究テーマの見直し候補をビルドのログに出す(ワークフローが警告・PR の説明に転記する)
for (const r of themeReview(allMembers, allPubs)) {
  console.log(`[研究テーマ要見直し] ${r.member.data.name}(${r.member.id}): ${r.reason} — ${r.newer.slice(0, 3).map((p) => `${p.data.date ?? p.data.year} ${p.data.title}`).join(' / ')}`);
}
const pubsOf = (m: any) => pubMap.get(m.id) ?? [];

const current = allMembers.filter((m) => m.data.status === '在籍').sort(byOrder);
const alumni = allMembers
  .filter((m) => m.data.status === '卒業・修了')
  .sort((a, b) => (b.data.graduated ?? '').localeCompare(a.data.graduated ?? '') || byOrder(a, b));

const facultyRoles = ['教授', '准教授', '助教', '特任教員'];
const staffRoles = [...facultyRoles, '研究員', '技術補佐員', '事務補佐員', 'リサーチアシスタント'];
const faculty = current.filter((m) => facultyRoles.includes(m.data.role));
const groups = [
  { label: 'スタッフ', en: 'Staff', roles: ['研究員', '技術補佐員', '事務補佐員'] },
  { label: '博士課程', en: 'Doctoral Course', roles: ['博士課程'] },
  { label: '修士課程', en: 'Master Course', roles: ['修士課程'] },
  { label: '学部生', en: 'Undergraduate', roles: ['学部生'] },
  { label: '研究生', en: 'Research Student', roles: ['研究生'] },
  { label: 'リサーチアシスタント(学生アルバイト)', en: 'Research Assistant', roles: ['リサーチアシスタント'] },
]
  .map((g) => ({ ...g, people: current.filter((m) => g.roles.includes(m.data.role)) }))
  .filter((g) => g.people.length > 0);
const count = current.filter((m) => m.data.role !== 'リサーチアシスタント').length;

// 卒業生は年ごとに、元スタッフは別にまとめる
const formerStaff = alumni.filter((m) => staffRoles.includes(m.data.role));
const alumniStudents = alumni.filter((m) => !staffRoles.includes(m.data.role));
const yearOf = (m: any) => (m.data.graduated ? `${String(m.data.graduated).slice(0, 4)}年` : '年不明');
const alumniYears = [...new Set(alumniStudents.map(yearOf))]
  .sort((a, b) => b.localeCompare(a))
  .map((y) => [y, alumniStudents.filter((m) => yearOf(m) === y)] as const);
---
<Base title="メンバー" current="/members/">
  <PageHead kicker="Members" title="メンバー" lead={`現在 ${count} 名が在籍しています。「詳細 ＋」のあるメンバーは、押すと実績などを見られます。`} />
  <section class="section">
    <div class="wrap">
      <figure class="members-photo">
        <img src={url('/images/lab/group-2026-outdoor.jpg')} alt="菅原研究室メンバーの集合写真" width="1600" height="1067" loading="lazy" />
      </figure>

      <ul class="member-grid pi-grid">
        {faculty.map((m) => <MemberCard m={m} pubs={pubsOf(m)} big />)}
      </ul>

      {groups.map((g) => (
        <div class="member-group">
          <h3>{g.label} <span class="en">{g.en}</span></h3>
          <ul class="member-grid">
            {g.people.map((m) => <MemberCard m={m} pubs={pubsOf(m)} sub={g.roles.length > 1 ? m.data.role : undefined} />)}
          </ul>
        </div>
      ))}

      {alumniYears.length > 0 && (
        <div class="member-group alumni">
          <h3>卒業生・修了生 <span class="en">Alumni</span></h3>
          {alumniYears.map(([year, people]) => (
            <div class="alumni-year">
              <h4>{year}</h4>
              <ul class="member-grid">
                {people.map((m) => <MemberCard m={m} pubs={pubsOf(m)} sub={`${alumniLabel(m.data.role)}${m.data.note ? `(${m.data.note})` : ''}`} />)}
              </ul>
            </div>
          ))}
        </div>
      )}

      {formerStaff.length > 0 && (
        <div class="member-group alumni">
          <h3>元スタッフ <span class="en">Former Staff</span></h3>
          <ul class="member-grid">
            {formerStaff.map((m) => <MemberCard m={m} pubs={pubsOf(m)} sub={`${m.data.role}${m.data.graduated ? ` · ${m.data.graduated}年まで` : ''}`} />)}
          </ul>
        </div>
      )}
    </div>
  </section>
  <script is:inline>
    (() => {
      document.querySelectorAll('.member-open').forEach((btn) => {
        const dlg = document.getElementById(btn.dataset.dialog);
        if (!dlg || !dlg.showModal) return;
        btn.addEventListener('click', () => dlg.showModal());
        dlg.querySelector('.md-close').addEventListener('click', () => dlg.close());
        // 外側(暗い部分)を押しても閉じる
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        // 「それ以前の〇〇を表示」で、6件目以降を開閉
        dlg.querySelectorAll('.show-more').forEach((more) => {
          more.addEventListener('click', () => {
            const open = more.getAttribute('aria-expanded') !== 'true';
            more.previousElementSibling.querySelectorAll('.is-more').forEach((li) => { li.hidden = !open; });
            more.setAttribute('aria-expanded', String(open));
            more.textContent = open ? more.dataset.less : more.dataset.more;
          });
        });
      });
    })();
  </script>
</Base>
